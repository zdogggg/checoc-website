# Copy to .env and adjust. Never commit .env.

# PostgreSQL (docker-compose exposes the db on host port 5433)
DATABASE_URL=postgres://checoc:checoc@localhost:5433/checoc

# Session cookie secret, at least 32 random characters
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=

# First owner account, created by `npm run db:seed` (only if it does not exist yet)
ADMIN_EMAIL=admin@checoc.local
ADMIN_PASSWORD=

# Public site URL (canonical links, sitemap, Telegram links). Production: https://your-domain
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# false on staging / preview: robots.txt then keeps search engines out
NUXT_PUBLIC_INDEXABLE=true

# Bank account for VietQR transfers. The VietQR option is hidden at checkout until all three are set.
# Bank id = short name or BIN from https://api.vietqr.io/v2/banks (e.g. MB, VCB, TCB, 970422)
NUXT_PUBLIC_BANK_BANK_ID=
NUXT_PUBLIC_BANK_ACCOUNT_NO=
NUXT_PUBLIC_BANK_ACCOUNT_NAME=

# Optional Telegram message to the shop for every new order
# (create a bot with @BotFather, add it to a group, then read the chat id)
NUXT_TELEGRAM_BOT_TOKEN=
NUXT_TELEGRAM_CHAT_ID=

# Email login codes for customers via Resend (https://resend.com). Create an API key and verify
# your domain in Resend, then send from an address on it. Empty key = email sign-in disabled in
# production; in development the code is shown on screen instead.
NUXT_RESEND_API_KEY=
NUXT_MAIL_FROM=Chè Cốc <no-reply@your-domain>

# Web push: customers can follow an order and get a notification at each status change
# (iPhone: only from the home-screen app). Generate once and keep them: changing the keys
# silently drops every existing subscription.
#   npx web-push generate-vapid-keys
NUXT_PUBLIC_VAPID_PUBLIC_KEY=
NUXT_VAPID_PRIVATE_KEY=
# Must be a real email (Apple refuses .local / localhost / example addresses with BadJwtToken)
NUXT_VAPID_SUBJECT=mailto:you@your-domain

# SMS provider for customer login codes (see server/utils/sms.ts). Empty = sign-in by SMS is
# disabled in production; in development the code is shown on screen instead.
NUXT_SMS_PROVIDER=

# --- Production only (docker-compose.prod.yml, see docs/deploy.md) ---
# Domain served by Caddy with automatic HTTPS, without https://
DOMAIN=
# Database password; set once before the first start
POSTGRES_PASSWORD=
# Days of daily database dumps kept in ./backups
BACKUP_KEEP_DAYS=14
