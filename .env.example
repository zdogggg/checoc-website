# Copy to .env and adjust. Never commit .env.

# PostgreSQL (docker-compose exposes the db on host port 5433)
DATABASE_URL=postgres://checoc:checoc@localhost:5433/checoc

# Session cookie secret, at least 32 random characters
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=

# First owner account, created by `npm run db:seed` (only if it does not exist yet)
ADMIN_EMAIL=admin@checoc.local
ADMIN_PASSWORD=

# Public site URL, used for SEO / sitemap
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Bank account for VietQR transfers. The VietQR option is hidden at checkout until all three are set.
# Bank id = short name or BIN from https://api.vietqr.io/v2/banks (e.g. MB, VCB, TCB, 970422)
NUXT_PUBLIC_BANK_BANK_ID=
NUXT_PUBLIC_BANK_ACCOUNT_NO=
NUXT_PUBLIC_BANK_ACCOUNT_NAME=

# Optional Telegram message to the shop for every new order
# (create a bot with @BotFather, add it to a group, then read the chat id)
NUXT_TELEGRAM_BOT_TOKEN=
NUXT_TELEGRAM_CHAT_ID=
